includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            - tests/ArchTest.php
            - tests/Pest.php
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#Access to an undefined property Pest\\PendingCalls\\TestCall::\$processor#'
            path: tests/VectorProcessorTest.php
    peststan:
        testCaseClass: IllumaLaw\VectorSchema\Tests\TestCase
